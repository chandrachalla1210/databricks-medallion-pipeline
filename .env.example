# Copy to .env and fill in for local development (never commit .env)

# ── Databricks Workspace Hosts ─────────────────────────────────────────────
DATABRICKS_HOST_DEV=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_HOST_TEST=https://adb-yyyyyyyyyyyy.azuredatabricks.net
DATABRICKS_HOST_INT=https://adb-zzzzzzzzzzzz.azuredatabricks.net
DATABRICKS_HOST_PROD=https://adb-wwwwwwwwwwww.azuredatabricks.net

# ── PAT Tokens per environment ──────────────────────────────────────────────
DATABRICKS_TOKEN_DEV=dapi...
DATABRICKS_TOKEN_TEST=dapi...
DATABRICKS_TOKEN_INT=dapi...
DATABRICKS_TOKEN_PROD=dapi...

# ── Pipeline Parameters ─────────────────────────────────────────────────────
ENV=dev
CATALOG_NAME=dev_catalog
SCHEMA_PREFIX=medallion
SOURCE_SYSTEM=ecommerce
VOLUME_NAME=raw_landing
LOG_LEVEL=DEBUG

# ── Notifications ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
